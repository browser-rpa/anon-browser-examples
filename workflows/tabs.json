{
  "project_id": "local",
  "name": "标签页和历史记录示例",
  "description": "演示新建、切换、关闭标签页，以及前进、后退和刷新。",
  "graph": {
    "schema_version": 3,
    "start_node_id": "open",
    "nodes": [
      {
        "id": "open",
        "type": "browser.open",
        "version": 1,
        "config": {
          "headless": false
        },
        "ui": {
          "x": 40,
          "y": 160
        }
      },
      {
        "id": "first",
        "type": "browser.navigate",
        "version": 1,
        "config": {
          "url": "https://example.com/"
        },
        "ui": {
          "x": 280,
          "y": 160
        }
      },
      {
        "id": "new-tab",
        "type": "browser.new_tab",
        "version": 1,
        "config": {
          "output_variable": "tabs.search",
          "url": "https://www.google.com/"
        },
        "ui": {
          "x": 520,
          "y": 160
        }
      },
      {
        "id": "back",
        "type": "browser.back",
        "version": 1,
        "config": {},
        "ui": {
          "x": 760,
          "y": 160
        }
      },
      {
        "id": "forward",
        "type": "browser.forward",
        "version": 1,
        "config": {},
        "ui": {
          "x": 1000,
          "y": 160
        }
      },
      {
        "id": "reload",
        "type": "browser.reload",
        "version": 1,
        "config": {},
        "ui": {
          "x": 1240,
          "y": 160
        }
      },
      {
        "id": "switch",
        "type": "browser.switch_tab",
        "version": 1,
        "config": {
          "tab_id": {
            "variable_ref": "tabs.search"
          }
        },
        "ui": {
          "x": 1480,
          "y": 160
        }
      },
      {
        "id": "close-tab",
        "type": "browser.close_tab",
        "version": 1,
        "config": {
          "tab_id": {
            "variable_ref": "tabs.search"
          }
        },
        "ui": {
          "x": 1720,
          "y": 160
        }
      },
      {
        "id": "close",
        "type": "browser.close",
        "version": 1,
        "config": {},
        "ui": {
          "x": 1960,
          "y": 160
        }
      },
      {
        "id": "end",
        "type": "core.end",
        "version": 1,
        "config": {},
        "ui": {
          "x": 2200,
          "y": 160
        }
      }
    ],
    "edges": [
      {
        "from": "open",
        "from_port": "success",
        "to": "first",
        "to_port": "in"
      },
      {
        "from": "first",
        "from_port": "success",
        "to": "new-tab",
        "to_port": "in"
      },
      {
        "from": "new-tab",
        "from_port": "success",
        "to": "back",
        "to_port": "in"
      },
      {
        "from": "back",
        "from_port": "success",
        "to": "forward",
        "to_port": "in"
      },
      {
        "from": "forward",
        "from_port": "success",
        "to": "reload",
        "to_port": "in"
      },
      {
        "from": "reload",
        "from_port": "success",
        "to": "switch",
        "to_port": "in"
      },
      {
        "from": "switch",
        "from_port": "success",
        "to": "close-tab",
        "to_port": "in"
      },
      {
        "from": "close-tab",
        "from_port": "success",
        "to": "close",
        "to_port": "in"
      },
      {
        "from": "close",
        "from_port": "success",
        "to": "end",
        "to_port": "in"
      }
    ]
  }
}
