      { "id": "read-title", "type": "browser.read_title", "version": 1, "config": { "output_variable": "page.title" }, "ui": { "x": 1000, "y": 180 } },
      { "id": "read-url", "type": "browser.read_url", "version": 1, "config": { "output_variable": "page.url" }, "ui": { "x": 1240, "y": 180 } },
      { "id": "read-text", "type": "browser.read_text", "version": 1, "config": { "selector": "#result", "output_variable": "page.result" }, "ui": { "x": 1480, "y": 180 } },
      { "id": "read-attribute", "type": "browser.read_attribute", "version": 1, "config": { "selector": "#demo-link", "attribute": "href", "output_variable": "link.href" }, "ui": { "x": 1720, "y": 180 } },
      { "id": "clear", "type": "browser.clear", "version": 1, "config": { "selector": "#name" }, "ui": { "x": 1960, "y": 180 } },
      { "id": "type", "type": "browser.type", "version": 1, "config": { "selector": "#name", "text": "anon-browser" }, "ui": { "x": 2200, "y": 180 } },
      { "id": "select", "type": "browser.select", "version": 1, "config": { "selector": "#country", "value": "CN" }, "ui": { "x": 2440, "y": 180 } },
      { "id": "check", "type": "browser.check", "version": 1, "config": { "selector": "#accept", "checked": true }, "ui": { "x": 2680, "y": 180 } },
      { "id": "hover", "type": "browser.hover", "version": 1, "config": { "selector": "#help" }, "ui": { "x": 2920, "y": 180 } },
      { "id": "click", "type": "browser.click", "version": 1, "config": { "selector": "#submit" }, "ui": { "x": 3160, "y": 180 } },
      { "id": "press", "type": "browser.press", "version": 1, "config": { "selector": "#name", "key": "Enter" }, "ui": { "x": 3400, "y": 180 } },
