      { "id": "double-click", "type": "browser.double_click", "version": 1, "config": { "selector": "#result" }, "ui": { "x": 3880, "y": 180 } },
      { "id": "right-click", "type": "browser.right_click", "version": 1, "config": { "selector": "#result" }, "ui": { "x": 4120, "y": 180 } },
      { "id": "screenshot", "type": "browser.screenshot", "version": 1, "config": { "name": "browser-basics" }, "ui": { "x": 4360, "y": 180 } },
      { "id": "close", "type": "browser.close", "version": 1, "config": {}, "ui": { "x": 4600, "y": 180 } },
