{
  "project_id": "local",
  "name": "浏览器基础操作示例",
  "description": "覆盖常见浏览器节点。请把 demo.example 替换成自己的测试页面并调整选择器。",
  "graph": {
    "schema_version": 1,
    "start_node_id": "open",
    "nodes": [
