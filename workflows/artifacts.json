{
  "project_id": "local",
  "name": "文件和截图产物示例",
  "description": "演示生成 JSON、CSV、HTML 文件和浏览器截图，运行后可从 Run Artifacts 下载。",
  "graph": {
    "schema_version": 3,
    "start_node_id": "set",
    "nodes": [
      {
        "id": "set",
        "type": "data.set",
        "version": 1,
        "config": {
          "name": "rows",
          "value": [
            {
              "name": "Alice",
              "score": 10
            },
            {
              "name": "Bob",
              "score": 8
            }
          ]
        },
        "ui": {
          "x": 40,
          "y": 160
        }
      },
      {
        "id": "json",
        "type": "artifact.create",
        "version": 1,
        "config": {
          "content": {
            "variable_ref": "rows"
          },
          "format": "json",
          "name": "result",
          "output_variable": "artifact.json",
          "pretty_print": true
        },
        "ui": {
          "x": 280,
          "y": 160
        }
      },
      {
        "id": "csv",
        "type": "artifact.create",
        "version": 1,
        "config": {
          "columns": [
            "name",
            "score"
          ],
          "content": {
            "variable_ref": "rows"
          },
          "format": "csv",
          "include_bom": true,
          "include_header": true,
          "name": "result",
          "output_variable": "artifact.csv"
        },
        "ui": {
          "x": 520,
          "y": 160
        }
      },
      {
        "id": "html",
        "type": "artifact.create",
        "version": 1,
        "config": {
          "content": "\u003ch1\u003eanon-browser report\u003c/h1\u003e\u003cp\u003eGenerated by a workflow.\u003c/p\u003e",
          "format": "html",
          "name": "report",
          "output_variable": "artifact.html"
        },
        "ui": {
          "x": 760,
          "y": 160
        }
      },
      {
        "id": "end",
        "type": "core.end",
        "version": 1,
        "config": {},
        "ui": {
          "x": 1000,
          "y": 160
        }
      }
    ],
    "edges": [
      {
        "from": "set",
        "from_port": "success",
        "to": "json",
        "to_port": "in"
      },
      {
        "from": "json",
        "from_port": "success",
        "to": "csv",
        "to_port": "in"
      },
      {
        "from": "csv",
        "from_port": "success",
        "to": "html",
        "to_port": "in"
      },
      {
        "from": "html",
        "from_port": "success",
        "to": "end",
        "to_port": "in"
      }
    ]
  }
}
