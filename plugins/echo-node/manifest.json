{
  "id": "examples.echo",
  "name": "Echo 示例节点",
  "version": "0.2.0",
  "kind": "automation",
  "entrypoint": "bin/plugin",
  "permissions": [
    "variables.write"
  ],
  "nodes": [
    {
      "metadata": {
        "type": "examples.echo",
        "version": 1,
        "display_name": "Echo 输入",
        "description": "把输入文本输出到当前 Run",
        "category": "示例",
        "security_level": "sensitive",
        "idempotency": "idempotent"
      },
      "schema": {
        "version": 1,
        "input_schema": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "title": "输入值"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "title": "结果"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        },
        "ports": [
          {
            "name": "in",
            "kind": "input"
          },
          {
            "name": "success",
            "kind": "output"
          },
          {
            "name": "error",
            "kind": "error"
          }
        ]
      },
      "policy": {
        "capabilities": [
          "variables.write"
        ],
        "required_permissions": [
          "variables.write"
        ],
        "timeouts": {
          "default": 10000000000,
          "minimum": 100000000,
          "maximum": 60000000000
        },
        "resources": {},
        "max_attempts": 1
      }
    }
  ]
}
