{
  "id": "examples.capability",
  "name": "Capability 调用示例",
  "version": "0.2.0",
  "kind": "automation",
  "entrypoint": "bin/plugin",
  "permissions": [
    "browser.read",
    "variables.read",
    "variables.write",
    "network.fetch"
  ],
  "nodes": [
    {
      "metadata": {
        "type": "examples.capability.page_title",
        "version": 1,
        "display_name": "page_title（插件）",
        "description": "通过宿主授权能力调用，不直连浏览器",
        "category": "插件示例",
        "security_level": "sensitive",
        "idempotency": "idempotent"
      },
      "schema": {
        "version": 1,
        "input_schema": {
          "type": "object",
          "properties": {
            "output_variable": {
              "type": "string",
              "title": "保存到变量"
            }
          },
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "value": {}
          },
          "additionalProperties": false
        },
        "ports": [
          {
            "name": "in",
            "kind": "input"
          },
          {
            "name": "success",
            "kind": "output"
          },
          {
            "name": "error",
            "kind": "error"
          }
        ]
      },
      "policy": {
        "capabilities": [
          "browser.read",
          "variables.write"
        ],
        "required_permissions": [
          "browser.read",
          "variables.write"
        ],
        "timeouts": {
          "default": 10000000000,
          "minimum": 100000000,
          "maximum": 60000000000
        },
        "resources": {
          "profile_lease": true,
          "runtime": true,
          "active_page": true
        },
        "max_attempts": 1
      }
    },
